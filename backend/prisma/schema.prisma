generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String       @id @default(cuid())
  firebaseUid         String       @unique
  email               String?      @unique
  displayName         String?
  photoUrl            String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  lastLoginAt         DateTime?
  lastActivityAt      DateTime?
  onboardingCompleted Boolean      @default(false)
  isActive            Boolean      @default(true)
  progression         Progression?
  universe            Universe?
}

model Progression {
  id                  String   @id @default(cuid())
  userId              String   @unique
  totalXp             Int      @default(0)
  currentLevel        Int      @default(1)
  totalTasksCompleted Int      @default(0)
  totalTasksCreated   Int      @default(0)
  currentStreak       Int      @default(0)
  longestStreak       Int      @default(0)
  strength            Int      @default(1)
  intelligence        Int      @default(1)
  discipline          Int      @default(1)
  vitality            Int      @default(1)
  creativity          Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Universe {
  id                   String   @id @default(cuid())
  userId               String   @unique
  currentRegion        String   @default("starting-village")
  currentQuest         String?
  regionsUnlocked      Int      @default(1)
  questsCompleted      Int      @default(0)
  achievementsUnlocked Int      @default(0)
  currentUniverseState Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
