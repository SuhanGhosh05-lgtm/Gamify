generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String       @id @default(cuid())
  firebaseUid         String       @unique
  email               String?      @unique
  displayName         String?
  photoUrl            String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  lastLoginAt         DateTime?
  lastActivityAt      DateTime?
  onboardingCompleted Boolean      @default(false)
  characterComplete   Boolean      @default(false)
  isActive            Boolean      @default(true)
  progression         Progression?
  universe            Universe?
  character           Character?
}

model Progression {
  id                  String   @id @default(cuid())
  userId              String   @unique
  totalXp             Int      @default(0)
  currentLevel        Int      @default(1)
  totalTasksCompleted Int      @default(0)
  totalTasksCreated   Int      @default(0)
  currentStreak       Int      @default(0)
  longestStreak       Int      @default(0)
  strength            Int      @default(1)
  intelligence        Int      @default(1)
  discipline          Int      @default(1)
  vitality            Int      @default(1)
  creativity          Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Character {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  gender      String   @default("male")
  skinColor   String
  hairStyle   String
  hairColor   String
  outfitStyle String
  outfitColor String
  accessory   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Universe {
  id                   String    @id @default(cuid())
  userId               String    @unique
  universeName         String?
  currentRegion        String    @default("starting-village")
  questsCompleted      Int       @default(0)
  achievementsUnlocked Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  villages             Village[]

  @@index([userId])
}

model Village {
  id          String   @id @default(cuid())
  universeId  String
  name        String
  villageName String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  universe    Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  wards       Ward[]

  @@index([universeId])
}

model Ward {
  id          String   @id @default(cuid())
  villageId   String
  name        String
  wardName    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  village     Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)
  houses      House[]

  @@index([villageId])
}

model House {
  id            String   @id @default(cuid())
  wardId        String
  name          String
  houseName     String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ward          Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  currentQuests Quest[]

  @@index([wardId])
}

model Quest {
  id               String    @id @default(cuid())
  houseId          String
  title            String
  description      String?
  difficulty       String?
  estimatedMinutes Int?
  xpReward         Int       @default(0)
  completed        Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  house            House     @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId])
}
